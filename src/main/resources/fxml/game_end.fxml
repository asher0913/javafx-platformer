<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <Text text="Game Over!" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
    <Text text="Total Score: 0" style="-fx-font-size: 18px;" fx:id="totalScoreText"/>
    <Text text="Top 10 High Scores:" style="-fx-font-size: 18px;" />
    <VBox spacing="5" alignment="CENTER" fx:id="highScoresBox" />
    <Button text="Return to Main Menu" fx:id="mainMenuButton"/>
</VBox>
