<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox spacing="10" alignment="CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <Text text="Congratulations! You completed the level!" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
    <Text text="Score: 0" style="-fx-font-size: 18px;" fx:id="scoreText"/>
    <Button text="Next Level" fx:id="nextLevelButton"/>
    <Button text="Restart" fx:id="restartButton"/>
    <Button text="Exit" fx:id="exitButton"/>
</VBox>
